{
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",
      "Read(./**/*credential*)",
      "Read(./**/*key*)",

      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",

      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(cat **/.env*)",
      "Bash(grep * .env*)",
      "Bash(grep -R * .env*)",
      "Bash(printenv:*)",
      "Bash(env:*)",

      "Bash(curl *api_key*)",
      "Bash(curl *token*)",
      "Bash(curl *secret*)"
    ],
    "ask": [],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Edit",
      "Write",
      "MultiEdit",

      "Bash",
      "WebSearch",
      "WebFetch"
    ]
  }
}